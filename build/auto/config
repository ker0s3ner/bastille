#!/bin/sh
# live-build auto/config
# Generates the live-build configuration for Modernised THL.
set -e

lb config noauto \
  --distribution bookworm \
  --architectures amd64 \
  --binary-images iso-hybrid \
  --bootloader grub-efi \
  --debian-installer none \
  --archive-areas "main contrib non-free non-free-firmware" \
  --mirror-bootstrap "http://deb.debian.org/debian/" \
  --mirror-chroot "http://deb.debian.org/debian/" \
  --mirror-chroot-security "http://security.debian.org/debian-security/" \
  --mirror-binary "http://deb.debian.org/debian/" \
  --mirror-binary-security "http://security.debian.org/debian-security/" \
  --apt-recommends false \
  --apt-indices false \
  --compression gzip \
  --chroot-squashfs-compression-type gzip \
  --checksums sha512 \
  --iso-application "Bastille" \
  --iso-publisher "Bastille Project" \
  --iso-volume "BASTILLE" \
  --bootappend-live "boot=live components quiet splash username=user persistence persistence-encryption=luks" \
  --debootstrap-options "--exclude=systemd,systemd-sysv,libsystemd0,systemd-timesyncd --include=sysvinit-core,openrc,sysvinit-utils" \
  "${@}"
