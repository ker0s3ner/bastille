#!/bin/sh
# live-build auto/config
# Generates the live-build configuration for Modernised THL.
set -e

lb config noauto \
  --distribution bookworm \
  --architectures amd64 \
  --binary-images iso-hybrid \
  --bootloader grub-efi \
  --uefi-secure-boot disable \
  --debian-installer none \
  --archive-areas "main contrib non-free non-free-firmware" \
  --apt-recommends false \
  --apt-indices false \
  --debootstrap-options "--variant=minbase" \
  --compression xz \
  --checksums sha512 \
  --iso-application "Tinfoil Hat Linux Modern" \
  --iso-publisher "THL Project" \
  --iso-volume "THL-MODERN" \
  --hostname "thl" \
  --username "user" \
  --bootappend-live "boot=live components quiet splash username=user hostname=thl persistence persistence-encryption=luks" \
  "${@}"
