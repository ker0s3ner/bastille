#!/bin/sh
# live-build auto/config
# Generates the live-build configuration for Modernised THL.
set -e

lb config noauto \
  --distribution bookworm \
  --architectures arm64 \
  --binary-images iso-hybrid \
  --bootloader grub-efi \
  --uefi-secure-boot disable \
  --debian-installer none \
  --archive-areas "main contrib non-free non-free-firmware" \
  --apt-recommends false \
  --apt-indices false \
  --debootstrap-options "--variant=minbase" \
  --compression xz \
  --checksums sha512 \
  --iso-application "Bastille" \
  --iso-publisher "Bastille Project" \
  --iso-volume "BASTILLE" \
  --bootappend-live "boot=live components quiet splash username=user hostname=bastille persistence persistence-encryption=luks" \
  "${@}"
