#!/bin/bash
# Install packages not in Debian 12 stable:
#   - fastfetch      (from GitHub releases .deb)
#   - dnscrypt-proxy (dropped from bookworm; from GitHub releases .deb)
#   - tuigreet       (from bookworm-backports; safety belt)
set -euo pipefail

ARCH=$(dpkg --print-architecture)

# ── fastfetch ─────────────────────────────────────────────────────────────────
install_fastfetch() {
    if command -v fastfetch >/dev/null 2>&1; then
        echo "[fastfetch] already installed, skipping"
        return 0
    fi

    local api_url="https://api.github.com/repos/fastfetch-cli/fastfetch/releases/latest"
    local tmpdir
    tmpdir=$(mktemp -d)

    echo "[fastfetch] fetching latest release info..."
    local release_json
    release_json=$(curl -fsSL "$api_url")

    local deb_name
    case "$ARCH" in
        amd64) deb_name="fastfetch-linux-amd64.deb" ;;
        arm64) deb_name="fastfetch-linux-aarch64.deb" ;;
        *)     echo "[fastfetch] unsupported arch $ARCH, skipping"; rm -rf "$tmpdir"; return 0 ;;
    esac

    local tmpjson
    tmpjson=$(mktemp)
    echo "$release_json" > "$tmpjson"

    local deb_url
    deb_url=$(python3 - "$tmpjson" "$deb_name" <<'PYEOF'
import sys, json
with open(sys.argv[1]) as f:
    data = json.load(f)
for a in data.get('assets', []):
    if a['name'] == sys.argv[2]:
        print(a['browser_download_url'])
        break
PYEOF
) || deb_url=""
    rm -f "$tmpjson"

    if [ -z "$deb_url" ]; then
        echo "[fastfetch] could not parse release JSON, skipping"
        rm -rf "$tmpdir"
        return 0
    fi

    echo "[fastfetch] downloading $deb_url"
    curl -fsSL -o "$tmpdir/fastfetch.deb" "$deb_url"
    dpkg -i "$tmpdir/fastfetch.deb" || apt-get install -f -y
    rm -rf "$tmpdir"
    echo "[fastfetch] installed OK"
}

# ── tuigreet (safety belt) ────────────────────────────────────────────────────
# bookworm-backports is already in archives/backports.list.chroot so apt should
# find it during the package-install phase. This runs after that phase and ensures
# it's present; if it was already installed this is a fast no-op.
ensure_tuigreet() {
    if command -v tuigreet >/dev/null 2>&1; then
        echo "[tuigreet] already installed"
        return 0
    fi
    echo "[tuigreet] installing from backports..."
    apt-get install -y -t bookworm-backports tuigreet
}

# ── dnscrypt-proxy ────────────────────────────────────────────────────────────
# Dropped from Debian bookworm (was in bullseye, back in trixie). Use GitHub
# official releases: https://github.com/DNSCrypt/dnscrypt-proxy/releases
install_dnscrypt_proxy() {
    if command -v dnscrypt-proxy >/dev/null 2>&1; then
        echo "[dnscrypt-proxy] already installed, skipping"
        return 0
    fi

    local api_url="https://api.github.com/repos/DNSCrypt/dnscrypt-proxy/releases/latest"
    local tmpdir
    tmpdir=$(mktemp -d)

    echo "[dnscrypt-proxy] fetching latest release info..."
    local release_json
    release_json=$(curl -fsSL "$api_url")

    # GitHub release uses linux_ prefix with arch names: linux_amd64, linux_arm64
    local asset_name
    case "$ARCH" in
        amd64) asset_name="dnscrypt-proxy-linux_x86_64-" ;;
        arm64) asset_name="dnscrypt-proxy-linux_arm64-" ;;
        *)     echo "[dnscrypt-proxy] unsupported arch $ARCH, skipping"; rm -rf "$tmpdir"; return 0 ;;
    esac

    local tmpjson
    tmpjson=$(mktemp)
    echo "$release_json" > "$tmpjson"

    local tar_url tag_name
    tar_url=$(python3 - "$tmpjson" "$asset_name" <<'PYEOF'
import sys, json
with open(sys.argv[1]) as f:
    data = json.load(f)
prefix = sys.argv[2]
for a in data.get('assets', []):
    if a['name'].startswith(prefix) and a['name'].endswith('.tar.gz'):
        print(a['browser_download_url'])
        break
PYEOF
) || tar_url=""
    tag_name=$(python3 - "$tmpjson" <<'PYEOF'
import sys, json
with open(sys.argv[1]) as f:
    data = json.load(f)
print(data.get('tag_name', ''))
PYEOF
) || tag_name=""
    rm -f "$tmpjson"

    if [ -z "$tar_url" ]; then
        echo "[dnscrypt-proxy] could not find tarball asset, skipping"
        rm -rf "$tmpdir"
        return 0
    fi

    echo "[dnscrypt-proxy] downloading $tar_url"
    curl -fsSL -o "$tmpdir/dnscrypt.tar.gz" "$tar_url"
    tar -C "$tmpdir" -xzf "$tmpdir/dnscrypt.tar.gz"

    # Find the extracted binary
    local bin
    bin=$(find "$tmpdir" -name "dnscrypt-proxy" -type f | head -1)
    if [ -z "$bin" ]; then
        echo "[dnscrypt-proxy] binary not found in archive, skipping"
        rm -rf "$tmpdir"
        return 0
    fi

    install -m 755 "$bin" /usr/sbin/dnscrypt-proxy

    # Create system user and dirs
    useradd -r -s /usr/sbin/nologin -d /var/cache/dnscrypt-proxy -M _dnscrypt-proxy 2>/dev/null || true
    install -d -m 750 -o _dnscrypt-proxy -g _dnscrypt-proxy /var/cache/dnscrypt-proxy

    # Install OpenRC service (already handled by thl-systemd-units hook)
    echo "[dnscrypt-proxy] installed version ${tag_name} OK"
    rm -rf "$tmpdir"
}

install_fastfetch
install_dnscrypt_proxy
ensure_tuigreet
