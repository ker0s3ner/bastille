#!/bin/bash
# Install packages not in Debian 12 stable:
#   - fastfetch (from GitHub releases .deb)
#   - tuigreet  (from bookworm-backports, already in archives list; this is a safety belt)
set -euo pipefail

ARCH=$(dpkg --print-architecture)

# ── fastfetch ─────────────────────────────────────────────────────────────────
install_fastfetch() {
    if command -v fastfetch >/dev/null 2>&1; then
        echo "[fastfetch] already installed, skipping"
        return 0
    fi

    local api_url="https://api.github.com/repos/fastfetch-cli/fastfetch/releases/latest"
    local tmpdir
    tmpdir=$(mktemp -d)

    echo "[fastfetch] fetching latest release info..."
    local release_json
    release_json=$(curl -fsSL "$api_url")

    local deb_name
    case "$ARCH" in
        amd64) deb_name="fastfetch-linux-amd64.deb" ;;
        arm64) deb_name="fastfetch-linux-aarch64.deb" ;;
        *)     echo "[fastfetch] unsupported arch $ARCH, skipping"; rm -rf "$tmpdir"; return 0 ;;
    esac

    local tmpjson
    tmpjson=$(mktemp)
    echo "$release_json" > "$tmpjson"

    local deb_url
    deb_url=$(python3 - "$tmpjson" "$deb_name" <<'PYEOF'
import sys, json
with open(sys.argv[1]) as f:
    data = json.load(f)
for a in data.get('assets', []):
    if a['name'] == sys.argv[2]:
        print(a['browser_download_url'])
        break
PYEOF
) || deb_url=""
    rm -f "$tmpjson"

    if [ -z "$deb_url" ]; then
        echo "[fastfetch] could not parse release JSON, skipping"
        rm -rf "$tmpdir"
        return 0
    fi

    echo "[fastfetch] downloading $deb_url"
    curl -fsSL -o "$tmpdir/fastfetch.deb" "$deb_url"
    dpkg -i "$tmpdir/fastfetch.deb" || apt-get install -f -y
    rm -rf "$tmpdir"
    echo "[fastfetch] installed OK"
}

# ── tuigreet (safety belt) ────────────────────────────────────────────────────
# bookworm-backports is already in archives/backports.list.chroot so apt should
# find it during the package-install phase. This runs after that phase and ensures
# it's present; if it was already installed this is a fast no-op.
ensure_tuigreet() {
    if command -v tuigreet >/dev/null 2>&1; then
        echo "[tuigreet] already installed"
        return 0
    fi
    echo "[tuigreet] installing from backports..."
    apt-get install -y -t bookworm-backports tuigreet
}

install_fastfetch
ensure_tuigreet
