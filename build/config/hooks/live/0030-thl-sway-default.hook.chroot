#!/bin/sh
# GNOME session defaults for the live user.
set -e

# GDM3 autologin for the live user (no password prompt on boot)
mkdir -p /etc/gdm3
cat > /etc/gdm3/custom.conf << 'EOF'
[daemon]
AutomaticLoginEnable=true
AutomaticLogin=user

[security]
# GDM runs as dedicated gdm user; no escalation path
DisallowTCP=true

[xdmcp]
Enable=false
EOF

# Disable GNOME's built-in idle suspend — bastille-bfu-idle handles this
mkdir -p /etc/dconf/db/local.d
cat > /etc/dconf/db/local.d/00-bastille << 'EOF'
[org/gnome/settings-daemon/plugins/power]
sleep-inactive-ac-type='nothing'
sleep-inactive-battery-type='nothing'
power-button-action='interactive'

[org/gnome/desktop/screensaver]
lock-enabled=true
lock-delay=uint32 0

[org/gnome/desktop/session]
idle-delay=uint32 300

[org/gnome/shell]
favorite-apps=['org.gnome.Nautilus.desktop', 'org.gnome.Terminal.desktop']
EOF

# Lock dconf keys so the user cannot weaken these settings
mkdir -p /etc/dconf/db/local.d/locks
cat > /etc/dconf/db/local.d/locks/bastille << 'EOF'
/org/gnome/settings-daemon/plugins/power/sleep-inactive-ac-type
/org/gnome/settings-daemon/plugins/power/sleep-inactive-battery-type
/org/gnome/desktop/screensaver/lock-enabled
EOF

dconf update || true
