#!/bin/sh
# Enable THL systemd units inside the chroot at build time.
set -e

# Core network security services
systemctl enable nftables.service
systemctl enable systemd-resolved.service
systemctl enable thl-enforce-dns.service

# VPN — wg-quick@wg0 is enabled but will only start if wg0.conf exists
# (populated by the profile setup or the user's own config)
systemctl enable wg-quick@wg0.service || true

# I2P router
systemctl enable i2pd.service

# AppArmor
systemctl enable apparmor.service

# Display manager (GNOME)
systemctl enable gdm.service
systemctl disable greetd.service || true

# RAM wipe on shutdown
systemctl enable bastille-ramwipe.service

# Auto-poweroff to BFU after idle
systemctl enable bastille-bfu-idle.service

# Make BFU poweroff script executable
chmod +x /usr/local/sbin/bastille-bfu-poweroff

# Flatpak: add Flathub as a user-level remote at first login
# (system-wide remote would require root; user remote does not)
install -d -m 755 /etc/profile.d
cat > /etc/profile.d/bastille-flatpak.sh << 'FLATPAK_INIT'
#!/bin/sh
# Add Flathub as a user remote on first login (no sudo needed)
if ! flatpak remotes --user 2>/dev/null | grep -q flathub; then
    flatpak remote-add --user --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo 2>/dev/null || true
fi
FLATPAK_INIT

# Disable services that leak information or are unnecessary
systemctl disable avahi-daemon.service   || true
systemctl disable cups.service           || true
systemctl disable bluetooth.service      || true
systemctl mask    NetworkManager-wait-online.service || true
