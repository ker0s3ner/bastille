#!/bin/sh
# Enable Bastille OS OpenRC services at build time.
set -e

# ── Make all init scripts executable ─────────────────────────────────────────
chmod +x /etc/init.d/bastille-ramwipe       || true
chmod +x /etc/init.d/bastille-bfu-idle      || true
chmod +x /etc/init.d/bastille-dsm-watchdog  || true
chmod +x /etc/init.d/bastille-update-check  || true
chmod +x /etc/init.d/thl-bluetooth-block    || true
chmod +x /etc/init.d/thl-me-neutralize      || true
chmod +x /etc/init.d/thl-dns-lock           || true
chmod +x /etc/init.d/thl-ram-scrub          || true
chmod +x /etc/init.d/thl-hostname           || true
chmod +x /etc/init.d/dnscrypt-proxy         || true
chmod +x /etc/init.d/thl-tlsdate            || true
chmod +x /etc/init.d/thl-tor               || true
chmod +x /etc/init.d/wg-quick.wg0           || true
chmod +x /usr/local/sbin/bastille-bfu-poweroff || true

# ── Enable services ───────────────────────────────────────────────────────────
# All rc-update calls use || true: custom init scripts may not be present yet.
# Standard Debian scripts (nftables, apparmor, etc.) are already registered.
rc-update add thl-hostname        boot    || true
rc-update add nftables            default || true
rc-update add dnscrypt-proxy      default || true
rc-update add thl-dns-lock        default || true
rc-update add thl-bluetooth-block boot    || true
rc-update add thl-me-neutralize   boot    || true
rc-update add apparmor            boot    || true
rc-update add usbguard            default || true
rc-update add NetworkManager      default || true
rc-update add seatd               boot    || true
rc-update add dbus                default || true
rc-update add greetd              default || true
rc-update add thl-tlsdate         default || true
rc-update add bastille-ramwipe    shutdown || true
rc-update add thl-ram-scrub       shutdown || true
rc-update add bastille-bfu-idle   default || true
rc-update add bastille-update-check default || true
rc-update add wg-quick.wg0        default || true

# DSM watchdog: enabled only when /etc/thl/dsm.enabled exists (checked at runtime)
rc-update add bastille-dsm-watchdog default || true

# Tor and i2pd: disabled by default; user enables via Settings > Network > Tor / i2p
# rc-update add thl-tor default || true
# rc-update add i2pd    default || true

# ── Flatpak: add Flathub as user remote at first login ────────────────────────
install -d -m 755 /etc/profile.d
cat > /etc/profile.d/bastille-flatpak.sh << 'FLATPAK_INIT'
#!/bin/sh
if ! flatpak remotes --user 2>/dev/null | grep -q flathub; then
    flatpak remote-add --user --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo 2>/dev/null || true
fi
FLATPAK_INIT
chmod 644 /etc/profile.d/bastille-flatpak.sh
