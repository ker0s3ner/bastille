#!/bin/sh
# Runs AFTER all packages are installed.
# Swaps systemd-sysv (the PID-1 symlink) for sysvinit-core + openrc.
# We keep the base systemd package so libsystemd0 continues to satisfy
# any package that links against it. Only the init symlink changes.
set -e

export DEBIAN_FRONTEND=noninteractive

# ── 1. Write apt.conf so dpkg uses --force-depends during this hook ───────────
mkdir -p /etc/apt/apt.conf.d
cat > /etc/apt/apt.conf.d/99bastille-force << 'APT'
APT::Get::allow-remove-essential "true";
Dpkg::Options:: "--force-depends";
Dpkg::Options:: "--force-remove-essential";
APT

# ── 2. Force-purge systemd-sysv via dpkg (bypasses apt conflict resolver) ─────
# systemd-sysv owns /sbin/init -> /lib/systemd/systemd
# sysvinit-core conflicts with systemd-sysv (both provide /sbin/init)
if dpkg -l systemd-sysv 2>/dev/null | grep -q '^ii'; then
    dpkg --force-depends --force-remove-essential --purge systemd-sysv
fi

# ── 3. Install sysvinit-core and openrc now that the conflict is gone ──────────
# sysvinit-core: provides /sbin/init (PID 1)
# openrc: service manager (manages all Bastille services)
apt-get -y --no-install-recommends \
    -o Dpkg::Options::="--force-depends" \
    install sysvinit-core sysvinit-utils openrc

# ── 4. Remove the force-depends override so future apt runs are normal ─────────
rm -f /etc/apt/apt.conf.d/99bastille-force

echo "[0001] sysvinit-core + openrc installed, systemd-sysv purged"
