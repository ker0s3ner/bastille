#!/bin/sh
# MUST run before ALL other hooks.
# Purge systemd and install sysvinit-core + openrc so that every subsequent
# package install sees the correct init system and does not re-pull systemd.
set -e

export DEBIAN_FRONTEND=noninteractive

# ── 1. Pin systemd at -1 so apt never (re-)installs it ───────────────────────
cat > /etc/apt/preferences.d/no-systemd << 'PIN'
Package: systemd systemd-sysv systemd-timesyncd libsystemd0 systemd-resolved
Pin: release *
Pin-Priority: -1
PIN

# ── 2. Allow apt to force-remove essential packages and ignore dep errors ─────
mkdir -p /etc/apt/apt.conf.d
cat > /etc/apt/apt.conf.d/99bastille-no-systemd << 'APT'
APT::Get::allow-remove-essential "true";
Dpkg::Options:: "--force-depends";
Dpkg::Options:: "--force-remove-essential";
APT

# ── 3. Force-purge systemd packages via dpkg directly (bypasses apt resolver) ─
# NOTE: do NOT use dpkg --set-selections hold — that causes "held broken
# packages" errors when apt tries to remove them to satisfy elogind conflicts.
for pkg in systemd-sysv systemd-timesyncd systemd libsystemd0 systemd-resolved; do
    if dpkg -l "$pkg" 2>/dev/null | grep -q '^ii'; then
        dpkg --force-depends --force-remove-essential --purge "$pkg" 2>/dev/null || true
    fi
done

# ── 4. Install sysvinit + openrc now that systemd is gone ─────────────────────
apt-get -y --no-install-recommends \
    -o Dpkg::Options::="--force-depends" \
    -o Dpkg::Options::="--force-remove-essential" \
    install sysvinit-core sysvinit-utils openrc

# ── 5. Install libelogind0 to replace libsystemd0 ─────────────────────────────
apt-get -y --no-install-recommends \
    -o Dpkg::Options::="--force-depends" \
    install libelogind0 2>/dev/null || true

echo "[0001] systemd purge complete, sysvinit+openrc installed"
