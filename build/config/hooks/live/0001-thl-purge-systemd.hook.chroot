#!/bin/sh
# Runs AFTER all packages are installed.
# Switches PID-1 from systemd-sysv to sysvinit-core and adds openrc.
#
# Key insight: openrc does NOT conflict with systemd-sysv in Debian 12.
# sysvinit-core DOES conflict with systemd-sysv.
# So the correct order is:
#   1. Install openrc (and all its deps) while systemd-sysv is still present
#   2. Force-purge systemd-sysv
#   3. Install sysvinit-core (conflict gone)
set -e

export DEBIAN_FRONTEND=noninteractive

# ── 1. Install openrc and its full dep chain (no conflict with systemd-sysv) ──
apt-get -y --no-install-recommends install openrc

# ── 2. Force-purge systemd-sysv (the PID-1 init symlink) ─────────────────────
# sysvinit-core conflicts with systemd-sysv, so remove it first.
# Keep the base systemd package — libsystemd0 satisfies many other packages.
if dpkg -l systemd-sysv 2>/dev/null | grep -q '^ii'; then
    dpkg --force-depends --force-remove-essential --purge systemd-sysv
fi

# ── 3. Fix broken 'init' metapackage, then install sysvinit-core ──────────────
# After purging systemd-sysv, 'init' is left with an unmet dep.
# apt-get -f install (no packages) resolves it automatically:
# with systemd-sysv gone, the only candidate is sysvinit-core.
apt-get -y -f --no-install-recommends install

# Now install remaining sysvinit pieces cleanly
apt-get -y --no-install-recommends install sysvinit-utils initscripts

echo "[0001] sysvinit-core + openrc installed, systemd-sysv purged"
