#!/bin/sh
# MUST run before ALL other hooks.
# Purge systemd and install sysvinit-core + openrc so that every subsequent
# package install sees the correct init system and does not re-pull systemd.
set -e

export DEBIAN_FRONTEND=noninteractive

# ── 1. Prevent systemd from ever being re-installed ───────────────────────────
cat > /etc/apt/preferences.d/no-systemd << 'PIN'
Package: systemd systemd-sysv systemd-timesyncd libsystemd0 systemd-resolved
Pin: release *
Pin-Priority: -1
PIN

# ── 2. Hold any currently installed systemd packages ─────────────────────────
for pkg in systemd systemd-sysv systemd-timesyncd libsystemd0 systemd-resolved; do
    dpkg -l "$pkg" >/dev/null 2>&1 && echo "$pkg hold" | dpkg --set-selections || true
done

# ── 3. Install sysvinit + openrc first (before they conflict) ─────────────────
apt-get -y --no-install-recommends install \
    sysvinit-core sysvinit-utils openrc 2>/dev/null || true

# ── 4. Now force-remove systemd packages that conflict with elogind ───────────
# Use --force-depends since sysvinit is already in place
for pkg in systemd-sysv systemd-timesyncd systemd; do
    dpkg -l "$pkg" >/dev/null 2>&1 && \
        dpkg --force-depends --force-remove-essential --purge "$pkg" 2>/dev/null || true
done

# libsystemd0 conflicts with libelogind0 — replace with libelogind0
dpkg -l libsystemd0 >/dev/null 2>&1 && \
    apt-get -y --no-install-recommends install \
        --allow-remove-essential \
        libelogind0 2>/dev/null || \
    apt-get -y --no-install-recommends install libelogind0 2>/dev/null || true

# ── 5. Make apt-get ignore systemd conflicts going forward ────────────────────
cat >> /etc/apt/apt.conf.d/99bastille-no-systemd << 'APT'
APT::Get::allow-remove-essential "true";
Dpkg::Options:: "--force-depends";
APT

echo "[0001] systemd purge complete, sysvinit+openrc installed"
