#!/bin/bash
set -euo pipefail

# ── Permissions ───────────────────────────────────────────────────────────────
chmod 700 /usr/local/bin/thl-lock
chmod 700 /usr/local/bin/thl-me-neutralize

# ── dnscrypt-proxy cache dir ──────────────────────────────────────────────────
install -d -m 750 /var/cache/dnscrypt-proxy
chown _dnscrypt-proxy:_dnscrypt-proxy /var/cache/dnscrypt-proxy 2>/dev/null || true

# ── Set UTC timezone ──────────────────────────────────────────────────────────
ln -sf /usr/share/zoneinfo/UTC /etc/localtime
echo "UTC" > /etc/timezone

# ── MSR module for ME neutralization (x86 only) ───────────────────────────────
arch=$(dpkg --print-architecture)
if [ "$arch" = "amd64" ] || [ "$arch" = "i386" ]; then
    echo "msr" >> /etc/modules
fi

# ── AppArmor profiles ─────────────────────────────────────────────────────────
# Pre-load profiles so they are active without systemd
if command -v apparmor_parser >/dev/null 2>&1; then
    apparmor_parser -r /etc/apparmor.d/ 2>/dev/null || true
fi
