#!/bin/bash
# Hook: Set permissions on all Bastille apps and helpers
set -euo pipefail

# ── seatd: add user to seat group so Sway can get seat access ─────────────────
usermod -aG seat user 2>/dev/null || true

# ── User-facing apps (executable by user) ─────────────────────────────────────
for bin in \
    /usr/local/bin/bastille-settings \
    /usr/local/bin/bastille-setup \
    /usr/local/bin/bastille-launcher \
    /usr/local/bin/bastille-powermenu \
    /usr/local/bin/bastille-notes \
    /usr/local/bin/bastille-calendar \
    /usr/local/bin/bastille-weather \
    /usr/local/bin/bastille-maps \
    /usr/local/bin/bastille-update \
    /usr/local/bin/bastille-subsystem; do
    [ -f "$bin" ] && chmod 755 "$bin"
done

# ── Polkit-gated root helpers (root:root, 700 — only pkexec can run these) ────
for sbin in \
    /usr/local/sbin/bastille-set-pins \
    /usr/local/sbin/bastille-set-service \
    /usr/local/sbin/bastille-set-nft \
    /usr/local/sbin/bastille-set-wg \
    /usr/local/sbin/bastille-set-dns \
    /usr/local/sbin/bastille-update \
    /usr/local/sbin/bastille-install \
    /usr/local/sbin/bastille-subsystem-root; do
    [ -f "$sbin" ] && chmod 700 "$sbin" && chown root:root "$sbin"
done

# ── Bastille config dir ────────────────────────────────────────────────────────
install -d -m 750 /etc/bastille
chown root:root /etc/bastille

# Create default version file if missing
if [ ! -f /etc/bastille/version ]; then
    echo "dev-$(date +%Y%m%d)" > /etc/bastille/version
fi

# ── Sway / Waybar / swaylock — fix home dir ownership ─────────────────────────
# These configs are laid in as root; chown to 'user' at runtime via login hook
# (done in /etc/profile.d/bastille-home-perms.sh)

# ── Polkit rules ──────────────────────────────────────────────────────────────
chmod 644 /usr/share/polkit-1/rules.d/50-bastille-helpers.rules 2>/dev/null || true

# ── Desktop database ──────────────────────────────────────────────────────────
update-desktop-database /usr/share/applications 2>/dev/null || true

# ── greetd — configure with agreety (text greeter, bundled with greetd) ───────
cat > /etc/greetd/config.toml << 'TOML'
[terminal]
vt = 1

[default_session]
command = "agreety --cmd sway"
user = "greeter"
TOML

echo "bastille-apps-setup: done"
