#!/bin/sh
# Build and install pam_thl_duress.so + DSM helpers inside the chroot.
set -e

# Build pam_thl_duress.so
# (gcc, make, libpam0g-dev, libsodium-dev, dpkg-dev pre-installed via package list)
cd /usr/local/src/thl-duress
make
make install DESTDIR=
make clean

# Build bastille-dsm-config setuid helper (no sudo — purpose-built privileged binary)
cd /usr/local/src/bastille-dsm-config
make
make install DESTDIR=
make clean

# Set action scripts executable and root-only
chmod 0700 /etc/thl/actions
chmod 0750 /etc/thl/actions/*.sh
chmod 0750 /usr/local/sbin/bastille-dsm
chmod 0750 /usr/local/sbin/bastille-dsm-prompt
chmod 0750 /usr/local/sbin/bastille-dsm-watchdog
# bastille-settings is the user-facing GTK panel; runs as the live user
chmod 0755 /usr/local/bin/bastille-settings
chown -R root:root /etc/thl

# Register DSM as a duress action in the config template.
# The actual PIN hashes are set at first-run setup time.
# This entry uses a placeholder hash — replaced by thl-duress-setup.
mkdir -p /etc/thl
cat >> /etc/thl/duress.conf.template << 'DURESS_CONF'
# DSM (Device Stress Mode) — set a PIN here to enable.
# When this PIN is entered, the UEFI is bricked and NVMe is crypto-erased.
# REPLACE_DSM_HASH is a placeholder; run thl-duress-setup to set a real PIN.
# duress  REPLACE_DSM_HASH  wipe  /usr/local/sbin/bastille-dsm
DURESS_CONF

# Install the PAM config snippet
# (written by 0050-thl-pam.hook.chroot which runs next)
