// Bastille OS — fastfetch config
// Uses the Tux-behind-bars logo.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "/etc/bastille/ascii.txt",
        "type": "file",
        "color": {
            "1": "blue",
            "2": "white",
            "3": "default",
            "4": "yellow"
        },
        "padding": {
            "right": 3
        }
    },
    "display": {
        "separator": ": ",
        "color": "blue"
    },
    "modules": [
        "title",
        "separator",
        {
            "type": "os",
            "key": "OS"
        },
        {
            "type": "kernel",
            "key": "Kernel"
        },
        {
            "type": "packages",
            "key": "Packages"
        },
        {
            "type": "shell",
            "key": "Shell"
        },
        {
            "type": "de",
            "key": "DE"
        },
        {
            "type": "wm",
            "key": "WM"
        },
        {
            "type": "terminal",
            "key": "Terminal"
        },
        {
            "type": "cpu",
            "key": "CPU",
            "showPeCoreCount": true
        },
        {
            "type": "memory",
            "key": "Memory"
        },
        {
            "type": "uptime",
            "key": "Uptime"
        },
        "colors"
    ]
}
