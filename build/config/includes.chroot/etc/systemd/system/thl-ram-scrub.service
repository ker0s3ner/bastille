[Unit]
Description=Bastille — secure RAM scrub on shutdown
DefaultDependencies=no
Before=shutdown.target reboot.target halt.target poweroff.target
After=umount.target

[Service]
Type=oneshot
ExecStart=/usr/bin/sdmem -f -l -l
TimeoutStartSec=120
RemainAfterExit=yes

[Install]
WantedBy=shutdown.target reboot.target halt.target poweroff.target
