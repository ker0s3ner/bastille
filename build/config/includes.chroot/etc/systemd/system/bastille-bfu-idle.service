[Unit]
Description=Auto-poweroff to BFU state after idle
After=graphical-session.target

[Service]
Type=simple
User=user
# Watch for GNOME idle signal via xprintidle; power off after 30 minutes idle
ExecStart=/bin/sh -c '\
    while true; do \
        idle=$(xprintidle 2>/dev/null || echo 0); \
        if [ "$idle" -ge 1800000 ]; then \
            /usr/local/sbin/bastille-bfu-poweroff; \
        fi; \
        sleep 60; \
    done'
Restart=on-failure

[Install]
WantedBy=graphical-session.target
