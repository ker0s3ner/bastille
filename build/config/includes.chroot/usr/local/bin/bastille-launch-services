#!/bin/sh
# bastille-launch-services — started by Sway exec_always
# Starts user-space daemons that need the Wayland session running.

# mako notification daemon
pgrep -x mako >/dev/null 2>&1 || mako &

# nm-applet (network tray icon)
pgrep -f nm-applet >/dev/null 2>&1 || nm-applet --indicator &

# polkit agent
pgrep -f lxpolkit >/dev/null 2>&1 || lxpolkit &

# kanshi (display layout daemon)
pgrep -x kanshi >/dev/null 2>&1 || kanshi &

wait
