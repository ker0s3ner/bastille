#!/usr/bin/env python3
"""bastille-powermenu — Wayland power menu."""
import gi
gi.require_version('Gtk', '4.0')
gi.require_version('Adw', '1')
import sys, subprocess
from gi.repository import Gtk, Adw, Gio, Gdk

class PowerMenu(Gtk.Window):
    ACTIONS = [
        ("Lock",         "system-lock-screen-symbolic",     ["swaylock"]),
        ("Suspend",      "weather-clear-night-symbolic",    ["systemctl", "suspend"]),
        ("Reboot",       "system-reboot-symbolic",          ["systemctl", "reboot"]),
        ("Power off",    "system-shutdown-symbolic",        ["systemctl", "poweroff"]),
    ]

    def __init__(self, app):
        super().__init__(application=app)
        self.set_title("Power")
        self.set_default_size(240, 280)
        self.set_decorated(False)

        css = Gtk.CssProvider()
        css.load_from_data(b"""
        window { background: rgba(11,12,16,0.96); border:1px solid #1f3a5f;
                 border-radius:12px; }
        button { background: transparent; border-radius:8px; padding:12px 16px;
                 color:#c9d1d9; }
        button:hover { background: rgba(79,143,212,0.15); }
        """)
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        box.set_margin_start(12); box.set_margin_end(12)
        box.set_margin_top(12); box.set_margin_bottom(12)

        for label, icon_name, cmd in self.ACTIONS:
            btn = Gtk.Button()
            btn_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
            img = Gtk.Image.new_from_icon_name(icon_name)
            img.set_pixel_size(20)
            lbl = Gtk.Label.new(label)
            lbl.set_halign(Gtk.Align.START)
            lbl.set_hexpand(True)
            btn_box.append(img); btn_box.append(lbl)
            btn.set_child(btn_box)
            btn.connect("clicked", lambda _, c=cmd: (subprocess.Popen(c), self.close()))
            box.append(btn)

        self.set_child(box)

        esc = Gtk.EventControllerKey()
        esc.connect("key-pressed", lambda c, k, *_: self.close() or True
                    if k == Gdk.KEY_Escape else False)
        self.add_controller(esc)
        self.connect("notify::is-active",
                     lambda w, _: self.close() if not w.get_property("is-active") else None)


class PowerApp(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="org.bastilleos.PowerMenu",
                         flags=Gio.ApplicationFlags.DEFAULT_FLAGS)
        self.connect("activate", lambda a: PowerMenu(a).present())

if __name__ == "__main__":
    sys.exit(PowerApp().run(sys.argv))
