#!/usr/bin/env python3
"""bastille-setup — Bastille OS first-boot configuration wizard."""

import gi
gi.require_version('Gtk', '4.0')
gi.require_version('Adw', '1')

import os
import sys
import subprocess
import json
from gi.repository import Gtk, Adw, Gio, GLib

APP_ID = "org.bastilleos.Setup"
DONE_FLAG = "/etc/bastille/setup.done"


def pkexec(cmd, *args):
    full = ["pkexec", cmd] + list(args)
    try:
        r = subprocess.run(full, capture_output=True, text=True, timeout=60)
        return r.returncode, r.stdout.strip(), r.stderr.strip()
    except Exception as e:
        return 1, "", str(e)


def is_live():
    """True if running from live media (not installed to disk)."""
    return os.path.exists("/run/live/medium")


# ── Wizard pages ──────────────────────────────────────────────────────────────

class WelcomePage(Adw.NavigationPage):
    def __init__(self):
        super().__init__(title="Welcome")
        sp = Adw.StatusPage()
        sp.set_icon_name("security-high-symbolic")
        sp.set_title("Welcome to Bastille OS")
        sp.set_description(
            "This wizard will configure your secure environment.\n"
            "It takes about 5 minutes. You can change any setting later in Settings."
        )
        sp.set_vexpand(True)
        self.set_child(sp)


class StorageModePage(Adw.NavigationPage):
    def __init__(self):
        super().__init__(title="Storage")
        self.mode = "live"  # or "disk"

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=24)
        box.set_margin_start(32); box.set_margin_end(32)
        box.set_margin_top(24); box.set_margin_bottom(24)
        box.set_valign(Gtk.Align.CENTER)

        title = Gtk.Label.new("How will you run Bastille?")
        title.add_css_class("title-2")
        title.set_margin_bottom(8)
        box.append(title)

        # Live USB card
        live_card = Gtk.Button()
        live_card.add_css_class("card")
        live_inner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        live_inner.set_margin_start(20); live_inner.set_margin_end(20)
        live_inner.set_margin_top(16); live_inner.set_margin_bottom(16)
        live_icon = Gtk.Image.new_from_icon_name("drive-removable-media-symbolic")
        live_icon.set_pixel_size(48)
        live_inner.append(live_icon)
        live_inner.append(Gtk.Label.new("Live USB (like Tails)"))
        live_sub = Gtk.Label.new("Runs entirely in RAM. Optional encrypted persistence partition. "
                                  "Nothing written to the host disk.")
        live_sub.add_css_class("dim-label")
        live_sub.add_css_class("caption")
        live_sub.set_wrap(True)
        live_sub.set_halign(Gtk.Align.CENTER)
        live_inner.append(live_sub)
        live_card.set_child(live_inner)
        live_card.connect("clicked", lambda _: self._select("live", live_card, disk_card))
        box.append(live_card)

        # Install to disk card
        disk_card = Gtk.Button()
        disk_card.add_css_class("card")
        disk_inner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        disk_inner.set_margin_start(20); disk_inner.set_margin_end(20)
        disk_inner.set_margin_top(16); disk_inner.set_margin_bottom(16)
        disk_icon = Gtk.Image.new_from_icon_name("drive-harddisk-symbolic")
        disk_icon.set_pixel_size(48)
        disk_inner.append(disk_icon)
        disk_inner.append(Gtk.Label.new("Install to Disk"))
        disk_sub = Gtk.Label.new("Full LUKS2-encrypted installation. Persistent across reboots. "
                                  "Requires a dedicated disk or partition.")
        disk_sub.add_css_class("dim-label")
        disk_sub.add_css_class("caption")
        disk_sub.set_wrap(True)
        disk_sub.set_halign(Gtk.Align.CENTER)
        disk_inner.append(disk_sub)
        disk_card.set_child(disk_inner)
        disk_card.connect("clicked", lambda _: self._select("disk", disk_card, live_card))
        box.append(disk_card)

        # Default selection
        live_card.add_css_class("suggested-action")
        self._live_card = live_card
        self._disk_card = disk_card

        scroll = Gtk.ScrolledWindow()
        scroll.set_child(box)
        self.set_child(scroll)

    def _select(self, mode, active, inactive):
        self.mode = mode
        active.add_css_class("suggested-action")
        inactive.remove_css_class("suggested-action")


