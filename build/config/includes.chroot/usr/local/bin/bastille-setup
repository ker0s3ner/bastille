        desc.set_wrap(True)
        desc.add_css_class("dim-label")
        box.append(desc)

        pg = Adw.PreferencesGroup()
        pg.set_title("Configuration")

        self._dev_row = Adw.ActionRow()
        self._dev_row.set_title("Target partition")
        self._dev_row.set_subtitle("e.g. /dev/sdb2 — must be empty")
