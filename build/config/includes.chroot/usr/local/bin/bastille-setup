        size_row.set_title("Persistence size (MB)")
        size_row.set_value(4096)
        self._size_row = size_row
        pg.add(size_row)

        skip_row = BastilleToggle("Skip for now", "Set up persistence later", active=True)
        self._skip = skip_row
        pg.add(skip_row)

        box.append(pg)
        scroll = Gtk.ScrolledWindow()
        scroll.set_child(box)
        self.set_child(scroll)


class BastilleToggle(Adw.ActionRow):
    def __init__(self, title, subtitle=None, active=False):
        super().__init__()
        self.set_title(title)
        if subtitle:
            self.set_subtitle(subtitle)
        self._sw = Gtk.Switch()
        self._sw.set_active(active)
        self._sw.set_valign(Gtk.Align.CENTER)
        self.add_suffix(self._sw)

    def get_active(self):
        return self._sw.get_active()


class UserPage(Adw.NavigationPage):
    def __init__(self):
        super().__init__(title="User Account")
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        box.set_margin_start(32); box.set_margin_end(32)
        box.set_margin_top(24); box.set_margin_bottom(24)

        title = Gtk.Label.new("User Account")
        title.add_css_class("title-2")
        box.append(title)

        pg = Adw.PreferencesGroup()
        pg.set_description("The default user 'user' will be configured. No sudo is ever granted.")

        pass_row = Adw.PasswordEntryRow()
        pass_row.set_title("Login password")
        self._pass = pass_row
        pg.add(pass_row)

        confirm_row = Adw.PasswordEntryRow()
        confirm_row.set_title("Confirm password")
        self._confirm = confirm_row
        pg.add(confirm_row)

        box.append(pg)
        scroll = Gtk.ScrolledWindow()
        scroll.set_child(box)
        self.set_child(scroll)

    def get_password(self):
        return self._pass.get_text()

    def passwords_match(self):
        return self._pass.get_text() == self._confirm.get_text()


class PinsPage(Adw.NavigationPage):
    def __init__(self):
        super().__init__(title="Security PINs")
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        box.set_margin_start(32); box.set_margin_end(32)
        box.set_margin_top(24); box.set_margin_bottom(24)

        title = Gtk.Label.new("Security PINs")
        title.add_css_class("title-2")
        box.append(title)

        banner = Adw.Banner()
        banner.set_title("All PINs are optional — you can set them later in Settings → Security Pins")
        banner.set_revealed(True)
        box.append(banner)

        pg = Adw.PreferencesGroup()
        pg.set_title("Optional PINs")

        for label, desc, attr in [
            ("Duress PIN", "Triggers RAM wipe + immediate poweroff", "_duress"),
            ("Fake Duress PIN", "Decoy wipe — boots to sanitised session", "_fake_duress"),
            ("DSM Check-in PIN", "Dead switch mode check-in code", "_dsm"),
        ]:
            row = Adw.PasswordEntryRow()
            row.set_title(label)
            sub = Gtk.Label.new(desc)
            sub.add_css_class("caption")
            sub.add_css_class("dim-label")
            pg.add(row)
            setattr(self, attr, row)

        box.append(pg)
        scroll = Gtk.ScrolledWindow()
        scroll.set_child(box)
        self.set_child(scroll)


class ProfilePage(Adw.NavigationPage):
    def __init__(self):
        super().__init__(title="Security Profile")
        self.profile = "high"

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        box.set_margin_start(32); box.set_margin_end(32)
        box.set_margin_top(24); box.set_margin_bottom(24)
        box.set_valign(Gtk.Align.CENTER)

        title = Gtk.Label.new("Security Profile")
        title.add_css_class("title-2")
        box.append(title)

        profiles = [
            ("Standard", "standard", "Basic hardening. Suitable for everyday use with privacy."),
            ("High Security", "high", "All protections active. Recommended for sensitive work."),
            ("Anonymity", "anon", "Adds Tor routing, MAC randomisation, metadata stripping."),
        ]

        self._cards = {}
        for name, key, desc in profiles:
            card = Gtk.Button()
            card.add_css_class("card")
            inner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            inner.set_margin_start(16); inner.set_margin_end(16)
            inner.set_margin_top(12); inner.set_margin_bottom(12)
            lbl = Gtk.Label.new(name)
            lbl.add_css_class("heading")
            lbl.set_halign(Gtk.Align.START)
            dlbl = Gtk.Label.new(desc)
            dlbl.add_css_class("caption")
            dlbl.add_css_class("dim-label")
            dlbl.set_halign(Gtk.Align.START)
            dlbl.set_wrap(True)
            inner.append(lbl)
            inner.append(dlbl)
            card.set_child(inner)
            card.connect("clicked", lambda _, k=key: self._select(k))
            self._cards[key] = card
            box.append(card)

        self._cards["high"].add_css_class("suggested-action")

        scroll = Gtk.ScrolledWindow()
        scroll.set_child(box)
        self.set_child(scroll)

    def _select(self, key):
        for k, c in self._cards.items():
            c.remove_css_class("suggested-action")
        self._cards[key].add_css_class("suggested-action")
        self.profile = key


class AppsPage(Adw.NavigationPage):
    def __init__(self):
        super().__init__(title="Applications")
        self._checks = {}

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        box.set_margin_start(32); box.set_margin_end(32)
        box.set_margin_top(24); box.set_margin_bottom(24)

        title = Gtk.Label.new("Applications")
        title.add_css_class("title-2")
        box.append(title)
        desc = Gtk.Label.new("Select apps to install from the Bastille verified catalogue. "
                              "All are sandboxed Flatpaks except system tools.")
        desc.add_css_class("dim-label"); desc.set_wrap(True)
        box.append(desc)

        groups = {
            "Communication": [
                ("Signal", "signal-desktop", True),
                ("Thunderbird", "org.mozilla.Thunderbird", True),
                ("Element (Matrix)", "im.riot.Riot", False),
            ],
            "Privacy tools": [
                ("Tor Browser", "com.github.micahflee.torbrowser-launcher", False),
                ("OnionShare", "org.onionshare.OnionShare", False),
                ("KeePassXC", "org.keepassxc.KeePassXC", True),
                ("Kleopatra (GPG)", "org.kde.kleopatra", False),
            ],
            "Media & Documents": [
                ("LibreOffice", "org.libreoffice.LibreOffice", True),
                ("VLC", "org.videolan.VLC", False),
                ("GIMP", "org.gimp.GIMP", False),
                ("Metadata Cleaner", "fr.romainvigier.MetadataCleaner", True),
            ],
            "Peripherals": [
                ("Cheese (webcam)", "org.gnome.Cheese", False),
                ("CUPS printer support", "system-cups", False),
            ],
        }

        scroll = Gtk.ScrolledWindow()
        scroll.set_vexpand(True)
        inner_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        inner_box.set_margin_top(8)

        for group_name, apps in groups.items():
            pg = Adw.PreferencesGroup()
            pg.set_title(group_name)
            for app_name, app_id, default in apps:
                row = Adw.ActionRow()
                row.set_title(app_name)
                row.set_subtitle(app_id)
                cb = Gtk.CheckButton()
                cb.set_active(default)
                cb.set_valign(Gtk.Align.CENTER)
                row.add_suffix(cb)
                pg.add(row)
                self._checks[app_id] = cb
            inner_box.append(pg)

        scroll.set_child(inner_box)
        box.append(scroll)
        self.set_child(box)

    def selected_apps(self):
        return [k for k, v in self._checks.items() if v.get_active()]


class VPNSetupPage(Adw.NavigationPage):
    def __init__(self):
        super().__init__(title="VPN Setup")
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        box.set_margin_start(32); box.set_margin_end(32)
        box.set_margin_top(24); box.set_margin_bottom(24)

        title = Gtk.Label.new("VPN / WireGuard")
        title.add_css_class("title-2")
        box.append(title)

        r_skip = BastilleToggle("Skip VPN setup", "Configure later in Settings → VPN", active=True)
        self._skip = r_skip

        pg = Adw.PreferencesGroup()
        pg.add(r_skip)
        box.append(pg)

        pg2 = Adw.PreferencesGroup()
        pg2.set_title("WireGuard config")
        pg2.set_description("Paste your wg0.conf here")
        self._tv = Gtk.TextView()
        self._tv.set_monospace(True)
        self._tv.set_wrap_mode(Gtk.WrapMode.NONE)
        self._tv.set_left_margin(12); self._tv.set_right_margin(12)
        self._tv.set_top_margin(8); self._tv.set_bottom_margin(8)
        sw = Gtk.ScrolledWindow()
        sw.set_min_content_height(200)
        sw.set_child(self._tv)
        pg2.set_header_suffix(sw)
        box.append(pg2)

        scroll = Gtk.ScrolledWindow()
        scroll.set_child(box)
        self.set_child(scroll)

    def get_wg_conf(self):
        if self._skip.get_active():
            return None
        buf = self._tv.get_buffer()
        return buf.get_text(buf.get_start_iter(), buf.get_end_iter(), False).strip() or None


