# ── Main wizard window ────────────────────────────────────────────────────────

class SetupWizard(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app)
        self.set_title("Bastille Setup")
        self.set_default_size(600, 680)
        self.set_deletable(False)

        toolbar = Adw.ToolbarView()
        header = Adw.HeaderBar()
        header.set_show_start_title_buttons(False)
        header.set_show_end_title_buttons(False)

        self._back_btn = Gtk.Button.new_with_label("Back")
        self._back_btn.connect("clicked", self._go_back)
        self._back_btn.set_sensitive(False)
        header.pack_start(self._back_btn)

        self._next_btn = Gtk.Button.new_with_label("Continue")
        self._next_btn.add_css_class("suggested-action")
        self._next_btn.connect("clicked", self._go_next)
        header.pack_end(self._next_btn)

        toolbar.add_top_bar(header)

        # Stack of pages
        self._stack = Gtk.Stack()
        self._stack.set_transition_type(Gtk.StackTransitionType.SLIDE_LEFT)
        self._stack.set_vexpand(True)

        self._pages = [
            WelcomePage(),
            StorageModePage(),
            PersistencePage(),
            UserPage(),
            PinsPage(),
            ProfilePage(),
            AppsPage(),
            VPNSetupPage(),
            SummaryPage(),
        ]
        self._storage_page = self._pages[1]
        self._persist_page = self._pages[2]
        self._user_page = self._pages[3]
        self._pins_page = self._pages[4]
        self._profile_page = self._pages[5]
        self._apps_page = self._pages[6]
        self._vpn_page = self._pages[7]

        for i, page in enumerate(self._pages):
            self._stack.add_named(page, str(i))
        self._current = 0
        self._stack.set_visible_child_name("0")

        progress = Gtk.ProgressBar()
        self._progress = progress
        progress.set_margin_start(24); progress.set_margin_end(24)
        progress.set_margin_bottom(8)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        box.append(self._stack)
        box.append(progress)
        toolbar.set_content(box)
        self.set_content(toolbar)
        self._update_nav()

    def _update_nav(self):
        n = len(self._pages)
        self._progress.set_fraction((self._current + 1) / n)
        self._back_btn.set_sensitive(self._current > 0)
        is_last = self._current == n - 1
        self._next_btn.set_label("Apply" if is_last else "Continue")
        if is_last:
            self._next_btn.remove_css_class("suggested-action")
            self._next_btn.add_css_class("suggested-action")

    def _go_next(self, *_):
        if self._current == len(self._pages) - 1:
            self._apply()
            return
        # Skip persistence page if installing to disk (handled by bastille-install)
        next_idx = self._current + 1
        if next_idx == 2 and self._storage_page.mode == "disk":
            next_idx = 3
        self._current = next_idx
        self._stack.set_transition_type(Gtk.StackTransitionType.SLIDE_LEFT)
        self._stack.set_visible_child_name(str(self._current))
        self._update_nav()

    def _go_back(self, *_):
        if self._current == 0:
            return
        prev_idx = self._current - 1
        if prev_idx == 2 and self._storage_page.mode == "disk":
            prev_idx = 1
        self._current = prev_idx
        self._stack.set_transition_type(Gtk.StackTransitionType.SLIDE_RIGHT)
        self._stack.set_visible_child_name(str(self._current))
        self._update_nav()

    def _apply(self):
        self._next_btn.set_sensitive(False)
        self._back_btn.set_sensitive(False)
        self._next_btn.set_label("Applying…")

        # Collect config
        config = {
            "storage_mode": self._storage_page.mode,
            "profile": self._profile_page.profile,
            "apps": self._apps_page.selected_apps(),
        }

        # Set password
        if self._user_page.passwords_match() and self._user_page.get_password():
            pkexec("/usr/bin/chpasswd", f"user:{self._user_page.get_password()}")

        # Set PINs
        for attr, pin_type in [("_duress", "duress"), ("_fake_duress", "fake-duress"), ("_dsm", "dsm")]:
            row = getattr(self._pins_page, attr)
            pin = row.get_text()
            if pin and len(pin) >= 4:
                pkexec("/usr/local/sbin/bastille-set-pins", f"--type={pin_type}", f"--pin={pin}")

        # WireGuard
        wg = self._vpn_page.get_wg_conf()
        if wg:
            pkexec("/usr/local/sbin/bastille-set-wg", "config", wg)

        # Write profile
        os.makedirs("/etc/bastille", exist_ok=True)
        with open("/etc/bastille/profile", "w") as f:
            f.write(config["profile"])

        # Install apps (background)
        if config["apps"]:
            apps = config["apps"]
            def install_apps():
                for app_id in apps:
                    if app_id.startswith("org.") or app_id.startswith("com.") or \
                       app_id.startswith("im.") or app_id.startswith("fr."):
                        subprocess.run(["flatpak", "install", "-y", "--noninteractive",
                                        "flathub", app_id],
                                       capture_output=True)
            import threading
            t = threading.Thread(target=install_apps, daemon=True)
            t.start()

        # If disk mode, launch bastille-install
        if config["storage_mode"] == "disk":
            subprocess.Popen(["bastille-install"], start_new_session=True)

        # Mark setup done
        open(DONE_FLAG, "w").close()

        sp = Adw.StatusPage()
        sp.set_icon_name("emblem-ok-symbolic")
        sp.set_title("Setup Complete")
        sp.set_description("Your Bastille OS environment is configured.\n"
                           "Apps are installing in the background.")
        done_btn = Gtk.Button.new_with_label("Start Bastille OS")
        done_btn.add_css_class("pill")
        done_btn.add_css_class("suggested-action")
        done_btn.set_halign(Gtk.Align.CENTER)
        done_btn.connect("clicked", lambda _: self.get_application().quit())
        sp.set_child(done_btn)

        self._stack.add_named(sp, "done")
        self._stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
        self._stack.set_visible_child_name("done")
        self._next_btn.set_visible(False)
        self._back_btn.set_visible(False)


class SetupApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.DEFAULT_FLAGS)
        self.connect("activate", self._on_activate)

    def _on_activate(self, app):
        mgr = Adw.StyleManager.get_default()
        mgr.set_color_scheme(Adw.ColorScheme.FORCE_DARK)
        win = SetupWizard(app)
        win.present()


if __name__ == "__main__":
    # Skip if already run
    if os.path.exists(DONE_FLAG) and "--force" not in sys.argv:
        sys.exit(0)
    app = SetupApp()
    sys.exit(app.run(sys.argv))
