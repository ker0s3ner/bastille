#!/usr/bin/env python3
"""
bastille-settings — Bastille security settings panel.

Launched from GNOME Applications as "Bastille Settings".
No sudo. Privileged writes go through the setuid helper
bastille-dsm-config (root-owned, 4750, auditable < 100 lines).
"""

import gi
gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gtk, Gdk, GLib, Pango
import subprocess
import os
import ctypes
import ctypes.util
import threading
import sys


HELPER     = "/usr/local/sbin/bastille-dsm-config"
ICON_NAME  = "security-high"


# ── Argon2id hashing in userspace (never passes raw PIN to helper) ────────

def _hash_pin(pin: str) -> str | None:
    lib_name = ctypes.util.find_library("sodium")
    if not lib_name:
        return None
    lib = ctypes.CDLL(lib_name)
    lib.crypto_pwhash_str.restype  = ctypes.c_int
    lib.crypto_pwhash_str.argtypes = [
        ctypes.c_char_p,
        ctypes.c_char_p,
        ctypes.c_ulonglong,
        ctypes.c_ulonglong,
        ctypes.c_size_t,
    ]
    OPSLIMIT = ctypes.c_ulonglong(3)
    MEMLIMIT = ctypes.c_size_t(67108864)   # 64 MB
    buf  = ctypes.create_string_buffer(128)
    data = pin.encode()
    ret  = lib.crypto_pwhash_str(buf, data, len(data), OPSLIMIT, MEMLIMIT)
    if ret != 0:
        return None
    return buf.value.decode()


def _helper(args: list[str]) -> tuple[int, str]:
    try:
        r = subprocess.run([HELPER] + args, capture_output=True, text=True)
        return r.returncode, (r.stdout + r.stderr).strip()
    except FileNotFoundError:
        return 1, "bastille-dsm-config not found"


def _dsm_status() -> bool:
    rc, out = _helper(["status"])
    return rc == 0 and out.strip() == "enabled"


# ── Main window ───────────────────────────────────────────────────────────

class BastilleSettings(Gtk.ApplicationWindow):

    def __init__(self, app):
        super().__init__(application=app, title="Bastille Settings")
        self.set_default_size(520, 480)
        self.set_resizable(False)
        self.set_position(Gtk.WindowPosition.CENTER)

        header = Gtk.HeaderBar(title="Bastille Settings", show_close_button=True)
        self.set_titlebar(header)

        self._build_ui()

    def _build_ui(self):
        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.add(outer)

        # ── Section: Device Stress Mode ──────────────────────────────────
        dsm_frame = self._section("Device Stress Mode")
        outer.pack_start(dsm_frame, False, False, 0)

        dsm_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        dsm_box.set_margin_start(16)
        dsm_box.set_margin_end(16)
        dsm_box.set_margin_top(8)
        dsm_box.set_margin_bottom(16)
        dsm_frame.add(dsm_box)

        # Enable toggle row
        toggle_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        toggle_label = Gtk.Label(
            label="Enable Device Stress Mode",
            xalign=0.0
        )
        toggle_label.set_hexpand(True)
        self._dsm_switch = Gtk.Switch()
        self._dsm_switch.set_active(_dsm_status())
        self._dsm_switch.connect("notify::active", self._on_dsm_toggle)
        toggle_row.pack_start(toggle_label, True, True, 0)
        toggle_row.pack_end(self._dsm_switch, False, False, 0)
        dsm_box.pack_start(toggle_row, False, False, 0)

        # Description
        desc = Gtk.Label(
            label="When triggered by a detected attack (Cellebrite, SSH hammering), "
                  "a fake lock screen appears. Give the DSM PIN to the examiner — "
                  "entering it permanently bricks the device.",
            xalign=0.0
        )
        desc.set_line_wrap(True)
        desc.set_max_width_chars(60)
        style = desc.get_style_context()
        style.add_class("dim-label")
        dsm_box.pack_start(desc, False, False, 0)

        # Status label
        self._dsm_status_label = Gtk.Label(xalign=0.0)
        self._update_status_label()
        dsm_box.pack_start(self._dsm_status_label, False, False, 0)

        # Change PIN button (only visible when enabled)
        self._change_pin_btn = Gtk.Button(label="Change DSM PIN…")
        self._change_pin_btn.connect("clicked", self._on_change_pin)
        self._change_pin_btn.set_halign(Gtk.Align.START)
        self._change_pin_btn.set_visible(_dsm_status())
        dsm_box.pack_start(self._change_pin_btn, False, False, 0)

        outer.show_all()

    def _section(self, title: str) -> Gtk.Frame:
        label = Gtk.Label()
        label.set_markup(f"<b>{title}</b>")
        frame = Gtk.Frame()
        frame.set_label_widget(label)
        frame.set_label_align(0.02, 0.5)
        frame.set_margin_start(16)
        frame.set_margin_end(16)
        frame.set_margin_top(16)
        return frame

    def _update_status_label(self):
        if _dsm_status():
            self._dsm_status_label.set_markup(
                '<span foreground="#e74c3c">● Active — watchdog running</span>'
            )
        else:
            self._dsm_status_label.set_markup(
                '<span foreground="#888">○ Inactive</span>'
            )

    def _on_dsm_toggle(self, switch, _param):
        if switch.get_active():
            self._show_pin_dialog(enabling=True)
        else:
            self._confirm_disable()

    def _confirm_disable(self):
        dlg = Gtk.MessageDialog(
            transient_for=self,
            flags=Gtk.DialogFlags.MODAL,
            message_type=Gtk.MessageType.WARNING,
            buttons=Gtk.ButtonsType.OK_CANCEL,
            text="Disable Device Stress Mode?",
        )
        dlg.format_secondary_text(
            "The DSM PIN will be securely erased. "
            "The device will no longer brick itself under attack."
        )
        response = dlg.run()
        dlg.destroy()
        if response == Gtk.ResponseType.OK:
            rc, msg = _helper(["disable"])
            if rc == 0:
                self._change_pin_btn.set_visible(False)
                self._update_status_label()
            else:
                self._error(f"Failed to disable DSM:\n{msg}")
                self._dsm_switch.handler_block_by_func(self._on_dsm_toggle)
                self._dsm_switch.set_active(True)
                self._dsm_switch.handler_unblock_by_func(self._on_dsm_toggle)
        else:
            self._dsm_switch.handler_block_by_func(self._on_dsm_toggle)
            self._dsm_switch.set_active(True)
            self._dsm_switch.handler_unblock_by_func(self._on_dsm_toggle)

    def _on_change_pin(self, _btn):
        self._show_pin_dialog(enabling=False)

    def _show_pin_dialog(self, enabling: bool):
        title = "Set DSM PIN" if enabling else "Change DSM PIN"
        dlg   = Gtk.Dialog(title=title, transient_for=self, modal=True)
        dlg.set_default_size(340, 0)
        dlg.add_button("Cancel", Gtk.ResponseType.CANCEL)
        ok_btn = dlg.add_button("Set PIN", Gtk.ResponseType.OK)
        ok_btn.get_style_context().add_class("suggested-action")

        content = dlg.get_content_area()
        content.set_spacing(12)
        content.set_margin_start(16)
        content.set_margin_end(16)
        content.set_margin_top(8)
        content.set_margin_bottom(8)

        if enabling:
            warn = Gtk.Label(
                label="⚠ Choose a PIN you can dictate under duress.\n"
                      "Do NOT use your login PIN.",
                xalign=0.0
            )
            warn.set_line_wrap(True)
            content.pack_start(warn, False, False, 0)

        entry1 = Gtk.Entry(placeholder_text="DSM PIN", visibility=False)
        entry2 = Gtk.Entry(placeholder_text="Confirm PIN", visibility=False)
        mismatch = Gtk.Label(label="", xalign=0.0)
        mismatch.override_color(Gtk.StateFlags.NORMAL, Gdk.RGBA(0.9, 0.3, 0.3, 1))

        content.pack_start(entry1, False, False, 0)
        content.pack_start(entry2, False, False, 0)
        content.pack_start(mismatch, False, False, 0)
        dlg.show_all()

        def _validate(*_):
            p1, p2 = entry1.get_text(), entry2.get_text()
            if p2 and p1 != p2:
                mismatch.set_text("PINs do not match")
                ok_btn.set_sensitive(False)
            elif len(p1) < 4:
                mismatch.set_text("PIN must be at least 4 characters")
                ok_btn.set_sensitive(False)
            else:
                mismatch.set_text("")
                ok_btn.set_sensitive(True)

        entry1.connect("changed", _validate)
        entry2.connect("changed", _validate)
        ok_btn.set_sensitive(False)

        response = dlg.run()
        pin = entry1.get_text()
        dlg.destroy()

        if response != Gtk.ResponseType.OK:
            if enabling:
                self._dsm_switch.handler_block_by_func(self._on_dsm_toggle)
                self._dsm_switch.set_active(False)
                self._dsm_switch.handler_unblock_by_func(self._on_dsm_toggle)
            return

        # Hash in background, then call helper
        def _do_enable():
            hashed = _hash_pin(pin)
            if not hashed:
                GLib.idle_add(self._error, "Failed to hash PIN (libsodium unavailable)")
                return
            rc, msg = _helper(["enable", hashed])
            if rc == 0:
                GLib.idle_add(self._on_enable_success)
            else:
                GLib.idle_add(self._error, f"Failed to write DSM config:\n{msg}")
                if enabling:
                    GLib.idle_add(self._dsm_switch.handler_block_by_func,
                                  self._on_dsm_toggle)
                    GLib.idle_add(self._dsm_switch.set_active, False)
                    GLib.idle_add(self._dsm_switch.handler_unblock_by_func,
                                  self._on_dsm_toggle)

        spinner_dlg = Gtk.MessageDialog(
            transient_for=self, modal=True,
            message_type=Gtk.MessageType.INFO,
            text="Hashing PIN…",
        )
        spinner_dlg.format_secondary_text("This takes a moment.")
        spinner_dlg.show()
        threading.Thread(target=_do_enable, daemon=True).start()
        GLib.timeout_add(200, lambda: not spinner_dlg.get_visible()
                         or (spinner_dlg.destroy() or False)
                         if not _dsm_status() else spinner_dlg.destroy() or False)

    def _on_enable_success(self):
        self._update_status_label()
        self._change_pin_btn.set_visible(True)

    def _error(self, msg: str):
        dlg = Gtk.MessageDialog(
            transient_for=self, modal=True,
            message_type=Gtk.MessageType.ERROR,
            buttons=Gtk.ButtonsType.OK,
            text="Error",
        )
        dlg.format_secondary_text(msg)
        dlg.run()
        dlg.destroy()


class BastilleApp(Gtk.Application):

    def __init__(self):
        super().__init__(application_id="io.bastille.Settings")

    def do_activate(self):
        win = BastilleSettings(self)
        win.present()


def main():
    app = BastilleApp()
    app.run(sys.argv)


if __name__ == "__main__":
    main()
