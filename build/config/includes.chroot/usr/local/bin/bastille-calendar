#!/usr/bin/env python3
"""bastille-calendar — Simple local calendar (no cloud, no accounts required)."""
import gi
gi.require_version('Gtk', '4.0')
gi.require_version('Adw', '1')
import sys, json, os
from datetime import date, datetime
from pathlib import Path
from gi.repository import Gtk, Adw, Gio, GLib

APP_ID = "org.bastilleos.Calendar"
DATA_FILE = Path.home() / ".local/share/bastille-calendar/events.json"

def load_events():
    try:
        with open(DATA_FILE) as f:
            return json.load(f)
    except Exception:
        return {}

def save_events(events):
    DATA_FILE.parent.mkdir(parents=True, exist_ok=True)
    with open(DATA_FILE, "w") as f:
        json.dump(events, f, indent=2)

class CalendarWindow(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app)
        self.set_title("Calendar")
        self.set_default_size(700, 500)
        self._events = load_events()

        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)

        # Calendar widget
        cal_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        header = Adw.HeaderBar()
        header.set_title_widget(Adw.WindowTitle.new("Calendar", ""))
        new_btn = Gtk.Button()
        new_btn.set_icon_name("list-add-symbolic")
        new_btn.connect("clicked", self._new_event)
        header.pack_end(new_btn)
        cal_box.append(header)

        self._cal = Gtk.Calendar()
        self._cal.set_margin_start(16); self._cal.set_margin_end(16)
        self._cal.set_margin_top(16); self._cal.set_margin_bottom(16)
        self._cal.connect("day-selected", self._on_day_selected)
        cal_box.append(self._cal)
        box.append(cal_box)

        sep = Gtk.Separator(orientation=Gtk.Orientation.VERTICAL)
        box.append(sep)

        # Events panel
        events_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        events_box.set_hexpand(True)
        lbl = Gtk.Label.new("Events")
        lbl.add_css_class("title-3")
        lbl.set_halign(Gtk.Align.START)
        lbl.set_margin_start(16); lbl.set_margin_top(64); lbl.set_margin_bottom(8)
        events_box.append(lbl)
        self._events_list = Gtk.ListBox()
        self._events_list.add_css_class("boxed-list")
        self._events_list.set_margin_start(16); self._events_list.set_margin_end(16)
        sw = Gtk.ScrolledWindow()
        sw.set_child(self._events_list)
        sw.set_vexpand(True)
        events_box.append(sw)
        box.append(events_box)

        self.set_content(box)
        self._refresh_markers()

    def _key(self, d=None):
        if d is None:
            d = self._cal.get_date()
        return f"{d.get_year()}-{d.get_month()+1:02d}-{d.get_day_of_month():02d}"

    def _on_day_selected(self, cal):
        self._load_day()

    def _load_day(self):
        while self._events_list.get_first_child():
            self._events_list.remove(self._events_list.get_first_child())
        key = self._key()
        for ev in self._events.get(key, []):
            row = Adw.ActionRow()
            row.set_title(ev.get("title", ""))
            row.set_subtitle(ev.get("time", ""))
            del_btn = Gtk.Button()
            del_btn.set_icon_name("user-trash-symbolic")
            del_btn.set_valign(Gtk.Align.CENTER)
            del_btn.connect("clicked", lambda _, e=ev, k=key: self._delete_event(k, e))
            row.add_suffix(del_btn)
            self._events_list.append(row)

    def _delete_event(self, key, ev):
        self._events.get(key, []).remove(ev)
        if not self._events.get(key):
            self._events.pop(key, None)
        save_events(self._events)
        self._load_day()
        self._refresh_markers()

    def _new_event(self, *_):
        dlg = Adw.MessageDialog.new(self)
        dlg.set_heading("New event")
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        box.set_margin_start(16); box.set_margin_end(16)
        title_e = Gtk.Entry(); title_e.set_placeholder_text("Event title")
        time_e = Gtk.Entry(); time_e.set_placeholder_text("Time (e.g. 14:00)")
        box.append(title_e); box.append(time_e)
        dlg.set_extra_child(box)
        dlg.add_response("cancel", "Cancel")
        dlg.add_response("add", "Add")
        dlg.set_response_appearance("add", Adw.ResponseAppearance.SUGGESTED)
        def resp(d, r):
            if r == "add" and title_e.get_text():
                key = self._key()
                self._events.setdefault(key, []).append({
                    "title": title_e.get_text(),
                    "time": time_e.get_text(),
                })
                save_events(self._events)
                self._load_day()
                self._refresh_markers()
        dlg.connect("response", resp)
        dlg.present()

    def _refresh_markers(self):
        self._cal.clear_marks()
        for key in self._events:
            try:
                parts = key.split("-")
                y, m, d = int(parts[0]), int(parts[1]), int(parts[2])
                d_obj = self._cal.get_date()
                if d_obj.get_year() == y and d_obj.get_month() + 1 == m:
                    self._cal.mark_day(d)
            except Exception:
                pass

class CalApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.DEFAULT_FLAGS)
        self.connect("activate", lambda a: CalendarWindow(a).present())

if __name__ == "__main__":
    Adw.StyleManager.get_default().set_color_scheme(Adw.ColorScheme.FORCE_DARK)
    sys.exit(CalApp().run(sys.argv))
