#!/usr/bin/env python3
"""bastille-launcher — Bastille OS application launcher (Wayland-native GTK4)."""

import gi
gi.require_version('Gtk', '4.0')
gi.require_version('Adw', '1')

import os
import sys
import subprocess
from pathlib import Path
from gi.repository import Gtk, Adw, Gio, GLib, Gdk

APP_ID = "org.bastilleos.Launcher"

def get_apps():
    """Return list of (name, exec_cmd, icon_name) from .desktop files."""
    dirs = [
        "/usr/share/applications",
        "/usr/local/share/applications",
        os.path.expanduser("~/.local/share/applications"),
        "/var/lib/flatpak/exports/share/applications",
    ]
    seen = set()
    apps = []
    for d in dirs:
        if not os.path.isdir(d):
            continue
        for f in sorted(Path(d).glob("*.desktop")):
            try:
                kv = {}
                with open(f) as fh:
                    in_entry = False
                    for line in fh:
                        line = line.strip()
                        if line == "[Desktop Entry]":
                            in_entry = True
                        elif line.startswith("[") and in_entry:
                            break
                        elif in_entry and "=" in line:
                            k, _, v = line.partition("=")
                            kv[k.strip()] = v.strip()
                if kv.get("Type") != "Application":
                    continue
                if kv.get("NoDisplay", "false").lower() == "true":
                    continue
                name = kv.get("Name", "")
                if not name or name in seen:
                    continue
                exec_cmd = kv.get("Exec", "").split("%")[0].strip()
                icon = kv.get("Icon", "application-x-executable")
                seen.add(name)
                apps.append((name, exec_cmd, icon))
            except Exception:
                continue
    return sorted(apps, key=lambda x: x[0].lower())


class LauncherWindow(Gtk.Window):
    def __init__(self, app):
        super().__init__(application=app)
        self.set_title("Launcher")
        self.set_default_size(520, 480)
        self.set_decorated(False)
        self.add_css_class("launcher-window")

        # Close on Escape
        esc = Gtk.EventControllerKey()
        esc.connect("key-pressed", self._on_key)
        self.add_controller(esc)

        # Close on focus-out
        self.connect("notify::is-active", lambda w, _: self.close() if not w.get_property("is-active") else None)

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)

        # Search bar
        search_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        search_box.set_margin_start(16); search_box.set_margin_end(16)
        search_box.set_margin_top(16); search_box.set_margin_bottom(8)
        icon = Gtk.Image.new_from_icon_name("system-search-symbolic")
        icon.set_pixel_size(18)
        search_box.append(icon)
        self._search = Gtk.Entry()
        self._search.set_placeholder_text("Search apps…")
        self._search.set_hexpand(True)
        self._search.connect("changed", self._on_search)
        self._search.connect("activate", self._launch_first)
        search_box.append(self._search)
        outer.append(search_box)

        sep = Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL)
        outer.append(sep)

        # App list
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll.set_vexpand(True)

        self._list = Gtk.ListBox()
        self._list.set_selection_mode(Gtk.SelectionMode.SINGLE)
        self._list.add_css_class("app-list")
        self._list.connect("row-activated", self._on_activate)
        scroll.set_child(self._list)
        outer.append(scroll)

        self._all_apps = get_apps()
        self._rows = []
        self._populate(self._all_apps)

        self.set_child(outer)
        self._search.grab_focus()
        self._apply_css()

    def _apply_css(self):
        css = b"""
        .launcher-window {
            background: rgba(11, 12, 16, 0.95);
            border: 1px solid #1f3a5f;
            border-radius: 12px;
        }
        .app-list { background: transparent; }
        .app-list row { border-radius: 8px; margin: 2px 8px; }
        .app-list row:hover { background: rgba(79,143,212,0.12); }
        .app-list row:selected { background: #1c4a8a; }
        entry { background: rgba(22,27,34,0.8); border: 1px solid #30363d;
                border-radius: 8px; color: #c9d1d9; padding: 8px 12px; }
        """
        provider = Gtk.CssProvider()
        provider.load_from_data(css)
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    def _populate(self, apps):
        while self._list.get_first_child():
            self._list.remove(self._list.get_first_child())
        self._rows = []
        for name, cmd, icon_name in apps[:50]:
            row = Gtk.ListBoxRow()
            box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
            box.set_margin_start(12); box.set_margin_end(12)
            box.set_margin_top(8); box.set_margin_bottom(8)
            try:
                img = Gtk.Image.new_from_icon_name(icon_name)
            except Exception:
                img = Gtk.Image.new_from_icon_name("application-x-executable")
            img.set_pixel_size(28)
            lbl = Gtk.Label.new(name)
            lbl.set_halign(Gtk.Align.START)
            box.append(img)
            box.append(lbl)
            row.set_child(box)
            row._cmd = cmd
            row._name = name
            self._list.append(row)
            self._rows.append(row)
        if self._rows:
            self._list.select_row(self._rows[0])

    def _on_search(self, entry):
        query = entry.get_text().lower()
        if not query:
            filtered = self._all_apps
        else:
            filtered = [(n, c, i) for n, c, i in self._all_apps if query in n.lower()]
        self._populate(filtered)

    def _on_key(self, ctrl, keyval, keycode, state):
        if keyval == Gdk.KEY_Escape:
            self.close()
            return True
        if keyval == Gdk.KEY_Down:
            sel = self._list.get_selected_row()
            if sel:
                nxt = sel.get_next_sibling()
                if nxt:
                    self._list.select_row(nxt)
            return True
        if keyval == Gdk.KEY_Up:
            sel = self._list.get_selected_row()
            if sel:
                prev = sel.get_prev_sibling()
                if prev:
                    self._list.select_row(prev)
            return True
        return False

    def _launch_first(self, *_):
        row = self._list.get_selected_row()
        if row:
            self._launch(row._cmd)

    def _on_activate(self, listbox, row):
        self._launch(row._cmd)

    def _launch(self, cmd):
        if cmd:
            subprocess.Popen(cmd, shell=True, start_new_session=True)
        self.close()


class LauncherApp(Gtk.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.DEFAULT_FLAGS)
        self.connect("activate", self._on_activate)

    def _on_activate(self, app):
        win = LauncherWindow(app)
        win.present()


if __name__ == "__main__":
    app = LauncherApp()
    sys.exit(app.run(sys.argv))
