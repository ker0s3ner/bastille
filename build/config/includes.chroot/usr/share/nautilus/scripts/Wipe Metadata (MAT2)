#!/bin/bash
# Bastille — wipe file metadata via MAT2.
# Right-click any file in Nautilus → Scripts → Wipe Metadata (MAT2)

output=""
while IFS= read -r file; do
    [ -z "$file" ] && continue
    result=$(mat2 "$file" 2>&1)
    output+="$(basename "$file"): $result\n"
done <<< "$NAUTILUS_SCRIPT_SELECTED_FILE_PATHS"

echo -e "$output" | zenity \
    --text-info \
    --title="MAT2 — Metadata Wiper" \
    --width=500 --height=250 \
    2>/dev/null || true
